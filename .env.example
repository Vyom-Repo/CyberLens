# Threat Intelligence API Keys (Keep secure, never commit to git)
VT_API_KEY=
ABUSEIPDB_API_KEY=

# Operation Mode:
# set to 'false' for live external API queries (VirusTotal + AbuseIPDB)
# set to 'true' for local offline intelligence simulation (for demos / no internet)
OFFLINE_MODE=false

# Database Configuration
DATABASE_URL=sqlite:///./analysis_history.db

# API Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
